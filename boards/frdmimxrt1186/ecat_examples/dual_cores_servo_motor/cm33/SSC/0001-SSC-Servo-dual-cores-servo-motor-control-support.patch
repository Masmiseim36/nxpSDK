+				if (LocalAxes[i].u32CycleTime != 0 && ((LocalAxes[i].Objects.objSupportedDriveModes >> (LocalAxes[i].Objects.objModesOfOperation - 1)) & 0x1)) {
+					ready++;
+				}
             }
     }
+	if(bDcSyncActive && active == ready) {
+		PDO_TRIGGER();	
+	}	
 }
 
 
